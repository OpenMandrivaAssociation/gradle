@@ -0,0 +1,25 @@
+package gradlebuild
+
+import org.gradle.api.file.Directory
+import org.gradle.api.file.ProjectLayout
+import java.io.File
+
+/**
+ * Bootstrap stand-in for ProjectLayout.settingsDirectory (Gradle 8.13+).
+ * Visible in this package without an import. A real member wins when this
+ * tree is later compiled by Gradle 9.
+ */
+val ProjectLayout.settingsDirectory: Directory
+    get() {
+        val projectDir = projectDirectory.asFile
+        var dir: File? = projectDir
+        var rel = ""
+        while (dir != null) {
+            if (File(dir, "settings.gradle.kts").isFile || File(dir, "settings.gradle").isFile) {
+                return if (rel.isEmpty()) projectDirectory else projectDirectory.dir(rel)
+            }
+            rel = if (rel.isEmpty()) ".." else "../$rel"
+            dir = dir.parentFile
+        }
+        return projectDirectory
+    }
